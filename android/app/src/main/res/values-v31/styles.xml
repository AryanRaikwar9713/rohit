<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses system splash API - force full black, no white icon box -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/black</item>
        <!-- Android 12+ splash: solid black only (removes white rounded icon box) -->
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/black</item>
    </style>
</resources>
